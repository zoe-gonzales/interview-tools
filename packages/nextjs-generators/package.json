{
  "name": "@interview-tools/nextjs-generators",
  "version": "0.0.1",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@interview-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
