  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "dependencies": {
    "@nx/devkit": "24.0.0",
    "@nx/express": "24.0.0",
    "@nx/next": "24.0.0",
    "tslib": "^2.3.0"
  },
  "generators": "./generators.json"
}
